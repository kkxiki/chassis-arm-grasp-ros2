{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agv_chassis_demo 复合抓取增量配置",
  "type": "object",
  "properties": {
    "vision": {
      "type": "object",
      "properties": {
        "provider_only": {"type": "boolean", "default": false, "description": "true 时仅提供确认目标，不启动抓取线程"},
        "transform_enabled": {"type": "boolean", "default": true, "description": "true 时调用 transform_xyz 并输出臂基座系坐标"},
        "depth_service": {"type": "string", "default": "gather_depth", "description": "GatherDepth 服务名"},
        "camera_info_topic": {"type": "string", "default": "", "description": "固定相机 CameraInfo 话题；空字符串表示不订阅、不做表面→中心补偿"},
        "service_client_node_name": {"type": "string", "default": "vision_grasp_fixed_service_client", "description": "服务客户端节点名；同一进程的每个 provider 必须唯一"},
        "transform_service": {"type": "string", "default": "transform_xyz", "description": "TransformXyz 服务名"}
      }
    },
    "wrist_vision": {
      "type": "object",
      "default": {
        "detections_topic": "/wrist/detections", "target_class_id": "39", "min_confidence": 0.4,
        "image_width": 1280, "image_height": 720, "center_deadband_px": 40.0,
        "stable_frames": 5, "release_frames": 10, "max_center_jump_px": 15.0,
        "execute_enabled": false, "provider_only": true, "transform_enabled": false,
        "depth_service": "/wrist/gather_depth", "transform_service": "transform_xyz",
        "service_client_node_name": "vision_grasp_wrist_service_client"
      },
      "description": "沿用 vision 的全部字段；此对象覆盖 VisionConfig，专供腕部相机。像素坐标固定为 1280×720。"
    },
    "grasp_mission": {
      "type": "object",
      "default": {
        "execute_enabled": false, "execute_chassis": false, "execute_arm": false, "execute_gripper": false,
        "site_x_m": 0.0, "site_y_m": 0.0, "site_yaw_deg": 0.0,
        "base_to_chassis_x_mm": 0.0, "base_to_chassis_y_mm": 0.0, "base_to_chassis_yaw_deg": 0.0,
        "approach_sweet_x_mm": 500.0, "approach_sweet_y_mm": 0.0,
        "max_approach_iterations": 3, "max_approach_step_mm": 400.0, "approach_tolerance_mm": 30.0,
        "approach_speed_mps": 0.1, "approach_angle_sign": 1, "approach_step_check_ratio": 0.6,
        "fine_iterations": 2, "max_fine_correction_mm": 60.0, "object_radius_mm": 0.0,
        "wrist_camera_info_topic": "/wrist/camera/color/camera_info",
        "wrist_camera_intrinsics": [615.0, 615.0, 640.0, 360.0],
        "gripper_to_camera_translation_mm": [0.0, 0.0, 0.0],
        "gripper_to_camera_rpy_deg": [0.0, 0.0, 0.0],
        "tool_grasp_offset_mm": [0.0, 0.0, 0.0],
        "pregrasp_dist_mm": 200.0, "grasp_rpy_deg": [-102.7, -39.0, -78.6],
        "release_joints": [0.0, -90.0, 0.0, -90.0, 0.0, 0.0],
        "safe_home_joints": [0.0, -90.0, 0.0, -90.0, 0.0, 0.0],
        "hand_close_cmd": "{MoveTwoFingersGripper --distance=0 --interval=25}",
        "hand_open_cmd": "{MoveTwoFingersGripper --distance=100 --interval=25}",
        "move_wait_ms": 3000, "hand_wait_ms": 900
      },
      "properties": {
        "execute_enabled": {"type": "boolean", "default": false, "description": "总闸；false 时三个子开关均不生效"},
        "execute_chassis": {"type": "boolean", "default": false, "description": "允许 S1/S3 底盘实际运动"},
        "execute_arm": {"type": "boolean", "default": false, "description": "允许 S5/S7/S9 机械臂实际运动"},
        "execute_gripper": {"type": "boolean", "default": false, "description": "允许 S8/S9 抓手 RPC"},
        "site_x_m": {"type": "number", "default": 0.0, "description": "S1 作业点地图 X，m"},
        "site_y_m": {"type": "number", "default": 0.0, "description": "S1 作业点地图 Y，m"},
        "site_yaw_deg": {"type": "number", "default": 0.0, "description": "S1 作业点朝向，度"},
        "base_to_chassis_x_mm": {"type": "number", "default": 0.0, "description": "臂基座到低盘中心安装外参 X，mm"},
        "base_to_chassis_y_mm": {"type": "number", "default": 0.0, "description": "臂基座到低盘中心安装外参 Y，mm"},
        "base_to_chassis_yaw_deg": {"type": "number", "default": 0.0, "description": "臂基座到低盘中心安装外参偏航，度"},
        "approach_sweet_x_mm": {"type": "number", "default": 500.0, "description": "臂基座系最佳作业点 X，mm"},
        "approach_sweet_y_mm": {"type": "number", "default": 0.0, "description": "臂基座系最佳作业点 Y，mm"},
        "max_approach_iterations": {"type": "integer", "minimum": 1, "default": 3, "description": "S3 最大重测迭代次数"},
        "max_approach_step_mm": {"type": "number", "minimum": 1, "default": 400.0, "description": "S3 单步硬上限，mm"},
        "approach_tolerance_mm": {"type": "number", "minimum": 0, "default": 30.0, "description": "S3 平面死区，mm"},
        "approach_speed_mps": {"type": "number", "default": 0.1, "description": "S3 平移速度，m/s"},
        "approach_angle_sign": {"type": "integer", "enum": [-1, 1], "default": 1, "description": "S3 数学 atan2 角到控制器角的符号；必须在 execute_enabled=false 的空载试验中确定，不得用增大 max_approach_step_mm 绕过"},
        "approach_step_check_ratio": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.6, "description": "S3 单步有效性判据阈值，无单位；实际缩减量须不小于该值乘以下发量"},
        "fine_iterations": {"type": "integer", "minimum": 1, "default": 2, "description": "S6 最大精定位迭代次数"},
        "max_fine_correction_mm": {"type": "number", "minimum": 1, "default": 60.0, "description": "S6 修正范数硬上限，mm"},
        "object_radius_mm": {"type": "number", "minimum": 0, "default": 0.0, "description": "表面→中心补偿半径，mm。取 0 意味着系统性偏近约一个物体半径；抓 500ml 瓶填 32.0"},
        "wrist_camera_info_topic": {"type": "string", "default": "/wrist/camera/color/camera_info", "description": "腕部 CameraInfo 话题"},
        "wrist_camera_intrinsics": {"type": "array", "minItems": 4, "maxItems": 4, "default": [615,615,640,360], "description": "[fx,fy,cx,cy]，px；仅当 CameraInfo 不可用时的应急值，必须实测确认"},
        "gripper_to_camera_translation_mm": {"type": "array", "minItems": 3, "maxItems": 3, "default": [0,0,0], "description": "gripper_T_camera 平移 [x,y,z]，mm"},
        "gripper_to_camera_rpy_deg": {"type": "array", "minItems": 3, "maxItems": 3, "default": [0,0,0], "description": "gripper_T_camera RPY [roll,pitch,yaw]，度"},
        "tool_grasp_offset_mm": {"type": "array", "minItems": 3, "maxItems": 3, "default": [0,0,0], "description": "夹爪闭合中心在工具系 [x,y,z]，mm"},
        "pregrasp_dist_mm": {"type": "number", "default": 200.0, "description": "预抓沿工具接近轴距离，mm"},
        "grasp_rpy_deg": {"type": "array", "minItems": 3, "maxItems": 3, "default": [-102.7,-39,-78.6], "description": "抓取姿态 RPY，度"},
        "release_joints": {"type": "array", "minItems": 6, "maxItems": 6, "default": [0,-90,0,-90,0,0], "description": "释放关节位 [J1..J6]，度"},
        "safe_home_joints": {"type": "array", "minItems": 6, "maxItems": 6, "default": [0,-90,0,-90,0,0], "description": "任务安全关节位 [J1..J6]，度；由 GraspMission 用 addJointPoint + moveToPoint 执行，不调用 goSafeHome()"},
        "hand_close_cmd": {"type": "string", "default": "{MoveTwoFingersGripper --distance=0 --interval=25}", "description": "合爪控制器 RPC"},
        "hand_open_cmd": {"type": "string", "default": "{MoveTwoFingersGripper --distance=100 --interval=25}", "description": "张爪控制器 RPC；distance=100 未经实测，必须先用 hardware_tests/arm 的 raw 命令逐步试出最大开口"},
        "move_wait_ms": {"type": "integer", "minimum": 1, "default": 3000, "description": "每个阻塞机械臂运动等待，ms"},
        "hand_wait_ms": {"type": "integer", "minimum": 1, "default": 900, "description": "合爪后必须等待，ms"}
      }
    }
  }
}
